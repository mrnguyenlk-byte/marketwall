# Keep the real file outside Git: C:\btrading-code\.vps-daily-analysis.env
DAILY_ANALYSIS_ENDPOINT=https://btrading.org/api/automation/daily-analysis/run
DAILY_AUTOMATION_SECRET=replace-with-the-same-secret-configured-on-btrading

# PNG output paths created by capture-ami-broker-charts.ps1.
VNINDEX_IMAGE_PATH=C:\BTradingData\daily-analysis\vnindex.png
GOLD_IMAGE_PATH=C:\BTradingData\daily-analysis\gold.png

# Authoritative CSV files produced by the existing VNINDEX and MT5 import jobs.
# The 07:00 runner reads their latest Date value before capture or any network call.
VNINDEX_CSV_PATH=C:\AmiBroker_AutoData\VNINDEX_D1_AB.csv
GOLD_CSV_PATH=C:\AmiBroker_AutoData\XAUUSD_D1_AB.csv

# Full, exact titles of the two AmiBroker child chart windows (case-sensitive).
# Do not use a symbol fragment or a partial title: copy the complete title displayed
# by AmiBroker. The capture script rejects missing or duplicate title matches.
AMIBROKER_PROCESS_NAME=Broker
VNINDEX_WINDOW_TITLE=VNINDEX
GOLD_WINDOW_TITLE=XAUUSD

# Gold capture stays at 06:00/06:32 and VNINDEX at 06:30. The 07:00 runner only
# reads their PNG outputs; it does not create or modify those capture schedules.
# Images older than 90 minutes are rejected.
TIMEZONE_ID=SE Asia Standard Time
MAX_IMAGE_AGE_MINUTES=90
LOCK_PATH=C:\BTradingData\daily-analysis\run.lock
LOG_PATH=C:\BTradingData\logs\daily-analysis-runner.log
HEALTH_PATH=C:\BTradingData\logs\daily-analysis-health.json

# Independent 07:30 Command Center briefing. This does not replace or modify
# the original 07:00 publisher. Keep the access token empty when the endpoint
# is exposed through a secret-protected public proxy.
COMMAND_CENTER_AUTO_PUBLISH_ENDPOINT=https://btrading-command-center.binh-nguyen-1597.chatgpt.site/api/briefings/auto-publish
COMMAND_CENTER_ACCESS_TOKEN=
COMMAND_CENTER_LOG_PATH=C:\BTradingData\logs\command-center-briefing.log
COMMAND_CENTER_STATE_PATH=C:\BTradingData\command-center
