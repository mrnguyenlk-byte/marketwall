{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "btrading-telegram-news-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "BTRADING_NEWS_ENDPOINT": "https://btrading.org/api/cron/telegram-market-alerts"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
